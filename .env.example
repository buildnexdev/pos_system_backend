PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=garments_shop
JWT_SECRET=garments_shop_jwt_secret_change_me
JWT_EXPIRES_IN=7d
CLIENT_URL=https://pos.buildnexdev.in

# AWS S3 (images / PDF / documents)
# ACCESS_KEY_ID must start with AKIA...
# SECRET_ACCESS_KEY is the long secret string (do not swap these)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=buildndexdev-pos-bucket
# Optional CDN / custom public base (otherwise https://BUCKET.s3.REGION.amazonaws.com/KEY)
# AWS_S3_PUBLIC_URL=
